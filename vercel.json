{
  "cleanUrls": false,
  "rewrites": [
    { "source": "/r/:code", "destination": "/index.html" },
    { "source": "/r/:code/", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Robots-Tag", "value": "noindex" }
    ] }
  ]
}
